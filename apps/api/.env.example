NODE_ENV=development
PORT=4000

# MongoDB — данные хранятся только на серверах в РФ (152-ФЗ)
MONGODB_URI=mongodb://127.0.0.1:27017/childgpt

# Общий с apps/web секрет подписи сессий (минимум 32 символа)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Откуда разрешены запросы с cookie (через запятую)
WEB_ORIGINS=http://localhost:3000,https://childgpt.ru
APP_URL=http://localhost:3000
APP_TIMEZONE=Europe/Moscow

# Языковая модель: siberi | mock (mock — для разработки без ключа).
# SIBERI_BASE_URL — адрес своего сервера Siberi (github.com/LDRION/siberi), запущенного с PORT=5005
LLM_PROVIDER=mock
SIBERI_API_KEY=
SIBERI_BASE_URL=http://127.0.0.1:5005/api/v1/ai

# always — судья входа проверяет каждое сообщение; on_signal — только подозрительные
SAFETY_INPUT_JUDGE=always
KID_MESSAGES_PER_MINUTE=10

# Уведомления родителям о важных событиях (необязательно)
SMTP_URL=
MAIL_FROM=ChildGPT <no-reply@childgpt.ru>
